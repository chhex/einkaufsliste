# Kopieren nach ".env" und mit echten Werten fuellen. ".env" selbst ist in
# .gitignore und wird NIE committed - so bleiben Credentials aus dem Repo raus.
#
# DB_ADMIN_* kommt vom jeweiligen Postgres-Anbieter/-Setup (lokal: selbst
# gewaehlt; Hetzner: ebenfalls selbst gewaehlt, siehe docker-compose.prod.yml),
# DB_APP_* legst Du selbst fest und richtest sie einmalig per
# backend/db-init/bootstrap-app-user.sh ein (siehe README).

DB_NAME=einkaufsliste

DB_ADMIN_USER=einkaufsliste_admin
DB_ADMIN_PASSWORD=change-me-admin

DB_APP_USER=einkaufsliste_app
DB_APP_PASSWORD=change-me-app

# JWT_SECRET: langer, zufaelliger String (mind. 32 Bytes) - z.B. per
# `openssl rand -base64 48` erzeugen. NIE den Default aus application.yml
# in Produktion verwenden.
JWT_SECRET=change-me-to-a-long-random-string-min-32-bytes

# GOOGLE_CLIENT_ID: aus der Google-Cloud-Console (OAuth2-Client-ID vom Typ
# "Web Application"), fuer die Frontend-Origin autorisiert. Wird gebraucht,
# um zu pruefen, dass ein eingehendes Google-ID-Token wirklich fuer unsere
# App ausgestellt wurde.
GOOGLE_CLIENT_ID=

# VITE_API_BASE_URL: nur fuer den Produktions-Build des Frontends
# (docker-compose.prod.yml, frontend/Dockerfile.prod) relevant. LEER LASSEN -
# das Frontend nutzt dann relative "/api/..."-Pfade, die nginx intern an den
# Backend-Container weiterreicht (siehe frontend/comprarli.conf). Nur bei
# einem abweichenden Setup (Frontend/Backend auf unterschiedlichen Domains)
# eine absolute URL setzen.
VITE_API_BASE_URL=

# --- Mehrere lokale Instanzen nebeneinander (optional) ---------------------
# Standardwerte genuegen fuer den normalen Betrieb. Nur setzen, wenn mehrere
# Klone/Varianten gleichzeitig laufen sollen (siehe README, "Mehrere lokale
# Instanzen"). Jeder Projektname hat eigene Container und ein eigenes
# DB-Volume; Host-Ports muessen pro Instanz verschieden sein.
#COMPOSE_PROJECT_NAME=einkaufsliste-local
#DB_PORT=5432
#BACKEND_PORT=8080
# Erlaubte Browser-Origins fuers Backend, kommagetrennt (z.B. anderer
# Frontend-Port oder die LAN-Adresse des Macs fuer iPhone/iPad-Tests):
#CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

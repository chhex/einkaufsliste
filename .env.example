# Kopieren nach ".env" und mit echten Werten fuellen. ".env" selbst ist in
# .gitignore und wird NIE committed - so bleiben Credentials aus dem Repo raus.
#
# Fuer Render gilt dasselbe Prinzip: DB_ADMIN_* kommt von der Render-Postgres-
# Instanz (Dashboard), DB_APP_* legst Du selbst fest und richtest sie einmalig
# per backend/db-init/bootstrap-app-user.sh ein (siehe README).

DB_NAME=einkaufsliste

DB_ADMIN_USER=einkaufsliste_admin
DB_ADMIN_PASSWORD=change-me-admin

DB_APP_USER=einkaufsliste_app
DB_APP_PASSWORD=change-me-app

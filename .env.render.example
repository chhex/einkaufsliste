# Kopieren nach ".env.render" und mit den echten Render-Werten fuellen.
# ".env.render" ist in .gitignore und wird NIE committed.
#
# PGHOST/PGUSER/PGPASSWORD/PGDATABASE: aus dem Render-Dashboard der
# Postgres-Instanz (Connection-Infos).
# APP_DB_USER/APP_DB_PASSWORD: selbst frei gewaehlt (App-User, wird hier
# neu angelegt) - diese Werte traegst Du danach auch als Env-Vars beim
# Backend-Web-Service auf Render ein.

PGHOST=dpg-xxxxx-a.frankfurt-postgres.render.com
PGPORT=5432
PGUSER=einkaufsliste_admin
PGPASSWORD=change-me-render-admin-password
PGDATABASE=einkaufsliste_irwo

APP_DB_USER=einkaufsliste_app
APP_DB_PASSWORD=change-me-render-app-password

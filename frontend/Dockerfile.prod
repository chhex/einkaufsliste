# --- Stage 1: Build-Prozess ---
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# --- Stage 2: Production-Image mit Nginx ---
FROM nginx:alpine
# Kopiert den Vite-Build in das Standard-Webverzeichnis von Nginx
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80

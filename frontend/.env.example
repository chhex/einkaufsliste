# Kopieren nach ".env" (wird von Vite automatisch geladen, nie committed -
# siehe .gitignore im Projekt-Root, gilt repo-weit auch fuer frontend/.env).
# Nur Variablen mit VITE_-Praefix sind im Browser-Code sichtbar
# (import.meta.env) - alles andere bleibt serverseitig/build-only.

VITE_API_BASE_URL=http://localhost:8080

# Dieselbe Google-Cloud-OAuth2-Client-ID wie im Backend (GOOGLE_CLIENT_ID),
# aber hier im Frontend gebraucht, um den Google-Login-Button zu initialisieren.
VITE_GOOGLE_CLIENT_ID=
